{
  "name": "@ti-tickets/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "install-agent": "npm run build -w @ti-tickets/shared && npm run build && tsx scripts/install-agent.ts",
    "uninstall-agent": "tsx scripts/uninstall-agent.ts"
  },
  "dependencies": {
    "@ti-tickets/shared": "*",
    "dotenv": "^17.2.1",
    "express": "^5.1.0"
  },
  "devDependencies": { "@types/express": "^5.0.3" }
}
