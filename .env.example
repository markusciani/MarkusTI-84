# Server
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/ti-tickets.sqlite
API_SECRET=replace-with-a-long-random-secret
BUILDER_PASSWORD_HASH=scrypt$replace-with-output-from-hash-script
BUILDER_SESSION_SECRET=replace-with-a-separate-long-random-secret

# Preferred: enable a signing secret in each Tally webhook and place it here.
TALLY_WEBHOOK_SECRET=replace-with-your-tally-signing-secret
# Fallback if a signing secret cannot be used. Send as ?token=... or X-Webhook-Token.
WEBHOOK_PATH_TOKEN=
ALLOW_INSECURE_WEBHOOKS=false

# Replace only after copying the real IDs from Tally.
TALLY_EVO_FORM_ID=TODO_TALLY_EVO_FORM_ID
TALLY_CE_FORM_ID=TODO_TALLY_CE_FORM_ID

# Mac sync agent
SYNC_API_URL=http://127.0.0.1:8787
SYNC_INTERVAL_SECONDS=45
NUMBERS_DOCUMENT_PATH=/absolute/path/to/TI Tickets.numbers
DRY_RUN=true
SYNC_NUMBERS_STATUSES=true
WEB_APP_ORIGIN=https://ti-ticket-builder.pages.dev
LOG_LEVEL=info
